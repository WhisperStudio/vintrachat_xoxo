{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:notifications": "node --test tests/notifications.test.mjs tests/auth-records.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-vintra-notifications --only firestore \"node --test tests/firestore.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local-firebase.mjs",
    "test:auth": "node --test tests/auth-records.test.mjs tests/local-auth.test.mjs tests/auth-loading.test.mjs tests/auth-session.test.mjs tests/auth-reset.test.mjs tests/verification-session.test.mjs tests/widget-account-defaults.test.mjs",
    "test:widget": "node --test tests/widget-mobile.test.mjs tests/widget-flow.test.mjs tests/studio-onboarding.test.mjs tests/assistant-context.test.mjs",
    "setup:stripe": "node scripts/setup-stripe.mjs",
    "test:billing": "firebase emulators:exec --project demo-vintra-notifications --only firestore \"node --test --test-concurrency=1 tests/firestore.test.mjs tests/billing.test.mjs\"",
    "test:stripe": "firebase emulators:exec --project demo-vintra-notifications --only firestore \"node tests/billing-stripe-smoke.mjs\"",
    "test:billing-http": "node tests/billing-webhook-http.mjs"
  },
  "dependencies": {
    "@types/styled-components": "^5.1.36",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.7.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "resend": "^6.9.4",
    "stripe": "^23.1.0",
    "styled-components": "^6.3.12",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "babel-plugin-react-compiler": "1.0.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5"
  }
}
